{
  "protocol": "AD-GS Waymo pristine baseline reproduction",
  "upstream_repository": "https://github.com/JiaweiXu8/AD-GS.git",
  "upstream_commit": "9a208512e49c8ddbaa20387921d9648adcd21cb4",
  "dataset_manifest": "analysis/manifests/waymo_adgs_8.json",
  "dataset_release": "Waymo Open Dataset Perception v1.4.1",
  "scenes": [
    "scene006",
    "scene026",
    "scene090",
    "scene105",
    "scene108",
    "scene134",
    "scene150",
    "scene181"
  ],
  "environment": {
    "gpu": "NVIDIA GeForce RTX 4090",
    "python": "3.7.16",
    "pytorch": "1.13.1+cu117",
    "torchvision": "0.14.1",
    "cuda_runtime": "11.7"
  },
  "official_config": "arguments/waymo.py",
  "seed": 0,
  "iterations": 60000,
  "published_reference": {
    "source": "ICCV 2025 paper Table 2 and supplementary Section B",
    "resolution": "1280x1920",
    "test_split": "one out of every four frames",
    "eight_scene_overall_metrics": {
      "PSNR": 33.91,
      "SSIM": 0.927,
      "LPIPS(VGG)": 0.228
    },
    "moving_object_PSNR": 27.41,
    "moving_object_mask_dependency": "StreetGS dynamic mask; not produced or evaluated by the public AD-GS render.py"
  },
  "comparison_policy": {
    "report_both_unweighted_scene_mean_and_frame_weighted_mean": true,
    "primary_table_comparison_assumption": "unweighted scene mean because the paper does not state its aggregation rule",
    "investigate_if_absolute_delta_exceeds": {
      "PSNR": 0.3,
      "SSIM": 0.005,
      "LPIPS(VGG)": 0.01
    },
    "tolerances_are_our_preregistered_audit_rule_not_author_provided": true,
    "unexpectedly_better_results_require_split_leakage_audit": true
  },
  "commands_per_scene": {
    "train": "python train.py -c ./arguments/waymo.py -s ./data/waymo/{scene} -m ./output/waymo/{scene} --data_device cuda:0",
    "render_and_evaluate": "python render.py -c ./arguments/waymo.py -m ./output/waymo/{scene} --data_device cuda:0 -v"
  },
  "isolated_execution": {
    "reason": "The upstream commit has no .gitignore; keep data, outputs, logs, and bytecode outside the pristine repository.",
    "python_environment_variable": "PYTHONDONTWRITEBYTECODE=1",
    "train": "{python} {baseline_repo}/train.py -c {baseline_repo}/arguments/waymo.py -s {source_root}/{scene} -m {run_root}/output/{scene} --data_device cuda:0",
    "render_and_evaluate": "{python} {baseline_repo}/render.py -c {baseline_repo}/arguments/waymo.py -m {run_root}/output/{scene} --data_device cuda:0 -v",
    "train_log": "{run_root}/logs/{scene}.train.log",
    "train_exitcode": "{run_root}/logs/{scene}.train.exitcode",
    "render_log": "{run_root}/logs/{scene}.render.log",
    "render_exitcode": "{run_root}/logs/{scene}.render.exitcode"
  },
  "hard_gate": {
    "repository_must_be_clean_before_and_after": true,
    "short_run_is_reproduction": false,
    "all_scenes_required": true,
    "required_per_scene_artifacts": [
      "cfg_args",
      "cameras.json",
      "input.ply",
      "logs/{scene}.train.log",
      "logs/{scene}.train.exitcode",
      "logs/{scene}.render.log",
      "logs/{scene}.render.exitcode",
      "point_cloud/iteration_60000/point_cloud.ply",
      "point_cloud/iteration_60000/env.pth",
      "test/ours_60000/renders",
      "test/ours_60000/gt",
      "train/ours_60000/renders",
      "train/ours_60000/gt",
      "results.json",
      "results-train.json"
    ],
    "required_metrics": [
      "SSIM",
      "PSNR",
      "LPIPS(VGG)",
      "LPIPS(ALEX)",
      "FPS"
    ],
    "method_integration_allowed_before_pass": false
  }
}
